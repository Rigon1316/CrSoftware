---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const title = 'Términos y Condiciones - CRSoftware';
const pageCss: string[] = [];
---
<BaseLayout title={title} pageCss={pageCss}>
  <Nav active="" />

  <section class="page-hero">
    <div class="page-hero-glow"></div>
    <div class="container">
      <span class="section-tag anim-fadeup">Legal</span>
      <h1 class="section-title anim-fadeup anim-delay-1">Términos y <span class="grad-text">Condiciones</span></h1>
      <p class="section-sub anim-fadeup anim-delay-2">Lea detenidamente los términos de uso de nuestros servicios digitales.</p>
    </div>
  </section>

  <section class="content-section" style="padding: 20px 0 60px 0;">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <div class="card" style="padding: 32px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
        <h2>1. Aceptación</h2>
        <p>Al acceder a nuestro sitio web y utilizar nuestros servicios, usted acepta cumplir con estos términos y condiciones.</p>
        <h2>2. Propiedad Intelectual</h2>
        <p>Todo el contenido, código y diseño desarrollado por CRSoftware Corporation es propiedad exclusiva de la empresa o sus licenciantes.</p>
        <h2>3. Limitación de Responsabilidad</h2>
        <p>No nos hacemos responsables por daños indirectos derivados del uso de nuestras plataformas fuera de los acuerdos específicos de mantenimiento.</p>
        <h2>4. Contacto</h2>
        <p>Si tiene preguntas sobre estos términos, contáctenos en <a href="mailto:crsoftwarecorporation@gmail.com">crsoftwarecorporation@gmail.com</a>.</p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
