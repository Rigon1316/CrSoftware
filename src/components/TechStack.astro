---
import * as icons from 'simple-icons';

const technologies = [
  { 
    name: "Next.js", 
    icon: icons.siNextdotjs,
    customColor: "#FFFFFF" 
  },
  { 
    name: "React", 
    icon: icons.siReact 
  },
  { 
    name: "TypeScript", 
    icon: icons.siTypescript 
  },
  { 
    name: "Tailwind CSS", 
    icon: icons.siTailwindcss 
  },
  { 
    name: "Laravel", 
    icon: icons.siLaravel 
  },
  { 
    name: "Astro", 
    icon: icons.siAstro 
  },
  { 
    name: "Python", 
    icon: icons.siPython 
  },
  { 
    name: "MySQL", 
    icon: icons.siMysql 
  }
];
---

<section class="tech-stack">
  <div class="container">
    <div class="section-header reveal">
      <span class="badge-outline">STACK TECNOLÓGICO</span>
      <h2>Herramientas de <span class="gradient-text-alt">vanguardia</span></h2>
    </div>

    <div class="carousel-container">
      <div class="carousel-track">
        {/* Render multiple times for infinite loop effect */}
        {[...technologies, ...technologies, ...technologies, ...technologies].map((tech) => (
          <div class="tech-pill">
            <span class="tech-icon">
              <svg viewBox="0 0 24 24" fill={tech.customColor || `#${tech.icon.hex}`} xmlns="http://www.w3.org/2000/svg">
                <path d={tech.icon.path} />
              </svg>
            </span>
            <span class="tech-name">{tech.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>


<style>
  .tech-stack {
    padding: 60px 0;
    overflow: hidden;
    position: relative;
    background: #020617;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .badge-outline {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    border: 1px solid rgba(147, 51, 234, 0.4);
    background: rgba(147, 51, 234, 0.05);
    color: #a855f7;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 1.2rem;
  }

  h2 {
    font-size: 3rem;
    font-weight: 800;
    color: white;
  }

  .gradient-text-alt {
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .carousel-container {
    width: 100%;
    position: relative;
    padding: 0.5rem 0;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: scroll 35s linear infinite;
  }

  .tech-pill {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: rgba(30, 41, 59, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    white-space: nowrap;
    transition: all 0.3s ease;
    cursor: default;
    backdrop-filter: blur(5px);
  }

  .tech-pill:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .tech-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .tech-icon :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tech-name {
    color: #f1f5f9;
    font-weight: 600;
    font-size: 0.95rem;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-25% - 0.375rem));
    }
  }

  .carousel-container:hover .carousel-track {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 2.2rem;
    }
    .carousel-track {
      animation-duration: 20s;
    }
    .tech-pill {
      padding: 0.4rem 1rem;
    }
    .tech-name {
      font-size: 0.85rem;
    }
  }
</style>
