---
<section class="contact-section" id="contacto">
  <div class="container">
    <div class="contact-grid">
      <!-- Left Column: Info Cards -->
      <div class="contact-info reveal">
        <div class="info-card whatsapp-card">
          <div class="icon-bg">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.27-2.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="info-content">
            <h4>Contacto Directo</h4>
            <p>+593 98 242 9029</p>
          </div>
        </div>

        <div class="info-card glass">
          <div class="icon-small">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div class="info-content">
            <h4>Correo Electrónico</h4>
            <p>crsoftwarecorporation@gmail.com</p>
          </div>
        </div>

        <div class="info-card glass">
          <div class="icon-small">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div class="info-content">
            <h4>Ubicación</h4>
            <p>Cuenca, Azuay, Ecuador</p>
          </div>
        </div>

        <div class="info-card glass">
          <div class="icon-small">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="info-content">
            <h4>Horario de Atención</h4>
            <p>Lunes – Viernes: 8:00 – 18:00 <br/> Sábados: 9:00 – 14:00</p>
          </div>
        </div>

        <div class="info-card glass coming-soon">
          <h5>PRÓXIMAMENTE</h5>
          <div class="future-emails">
            <p>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; vertical-align: middle;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              crsoftwarecorporation@gmail.com
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Form -->
      <div class="contact-form-container reveal">
        <h3>Envíanos un mensaje</h3>
        <form class="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label>Nombre completo</label>
              <input type="text" placeholder="Tu nombre" required />
            </div>
            <div class="form-group">
              <label>Teléfono</label>
              <input type="tel" placeholder="+593 ..." />
            </div>
          </div>

          <div class="form-group">
            <label>Correo electrónico</label>
            <input type="email" placeholder="tu@correo.com" required />
          </div>

          <div class="form-group">
            <label>Servicio de interés</label>
            <select>
              <option value="">Selecciona un servicio...</option>
              <option value="landing">Landing Page</option>
              <option value="corporativa">Web Corporativa</option>
              <option value="plataforma">Plataforma Web</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div class="form-group">
            <label>Cuéntanos sobre tu proyecto</label>
            <textarea rows="4" placeholder="Describe tu idea o proyecto..."></textarea>
          </div>

          <button type="submit" class="btn btn-gradient btn-full">
            Enviar mensaje <span class="arrow">→</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 100px 0;
    background: #020617;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  /* Info Cards Styles */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    padding: 1rem 1.2rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .whatsapp-card {
    background: #2563eb;
    color: white;
    border: none;
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2);
    cursor: default;
  }

  .whatsapp-card:hover {
    box-shadow: 0 15px 30px rgba(37, 99, 235, 0.3);
  }

  .icon-bg {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.6rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-small {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.8rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .info-content h4 {
    color: white;
    font-size: 1rem;
    margin-bottom: 0.1rem;
  }

  .whatsapp-card .info-content h4 { color: white; }

  .info-content p {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0;
  }

  .whatsapp-card .info-content p { color: rgba(255, 255, 255, 0.9); }

  .whatsapp-card .arrow {
    margin-left: auto;
    font-size: 1.5rem;
    opacity: 0.8;
  }

  .coming-soon {
    flex-direction: column;
    align-items: flex-start;
    padding: 1.2rem 1.5rem;
  }

  .coming-soon h5 {
    color: #a855f7;
    letter-spacing: 2px;
    font-size: 0.7rem;
    margin-bottom: 0.8rem;
  }

  .future-emails p {
    margin-bottom: 0.4rem;
    color: #6366f1;
    font-weight: 600;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
  }

  /* Form Styles */
  .contact-form-container {
    background: rgba(15, 23, 42, 0.5);
    padding: 3rem;
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .contact-form-container h3 {
    font-size: 2rem;
    color: white;
    margin-bottom: 2.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    color: white;
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
    font-weight: 500;
  }

  input, select, textarea {
    width: 100%;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem 1.2rem;
    border-radius: 12px;
    color: white;
    font-family: inherit;
    transition: all 0.3s ease;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: #6366f1;
    background: rgba(30, 41, 59, 0.8);
  }

  .btn-gradient {
    position: relative;
    overflow: hidden;
    z-index: 1;
    transition: all 0.4s ease;
  }

  .btn-gradient::before {
    content: '';
    position: absolute;
    bottom: -200%;
    left: 50%;
    transform: translateX(-50%) scale(0);
    width: 350%;
    padding-bottom: 350%;
    background: #22c55e;
    border-radius: 50%;
    z-index: -1;
    transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .btn-gradient:hover::before {
    transform: translateX(-50%) scale(1);
    bottom: -100%;
  }

  .btn-gradient:hover {
    box-shadow: 0 10px 25px rgba(34, 197, 94, 0.4);
    transform: translateY(-3px);
  }

  .btn-full {
    width: 100%;
    justify-content: center;
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  @media (max-width: 968px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .contact-form-container {
      padding: 2rem 1.5rem;
    }
  }
</style>
