<section class="contact-section" id="contacto">
  <div class="container">
    <div class="contact-grid">
      <!-- Left Column: Info Cards -->
      <div class="contact-info reveal">
        <a href="https://wa.me/593982429029" target="_blank" class="info-card whatsapp-card">
          <div class="icon-bg">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <div class="info-content">
            <h4>WhatsApp Directo</h4>
            <p>+593 98 242 9029</p>
          </div>
          <span class="arrow">→</span>
        </a>

        <div class="info-card glass">
          <div class="icon-small">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div class="info-content">
            <h4>Correo Electrónico</h4>
            <p>crsoftwarecorporation@gmail.com</p>
          </div>
        </div>

        <div class="info-card glass">
          <div class="icon-small">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div class="info-content">
            <h4>Ubicación</h4>
            <p>Cuenca, Azuay, Ecuador</p>
          </div>
        </div>

        <div class="info-card glass">
          <div class="icon-small">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="info-content">
            <h4>Horario de Atención</h4>
            <p>Lunes – Viernes: 8:00 – 18:00 <br/> Sábados: 9:00 – 14:00</p>
          </div>
        </div>

        <div class="info-card glass coming-soon">
          <h5>PRÓXIMAMENTE</h5>
          <div class="future-emails">
            <p>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; vertical-align: middle;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              contacto@crsoftwarecorporation.com
            </p>
            <p>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; vertical-align: middle;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              soporte@crsoftwarecorporation.com
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Form -->
      <div class="contact-form-container reveal">
        <h3>Envíanos un mensaje</h3>
        <form class="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label>Nombre completo</label>
              <input type="text" placeholder="Tu nombre" required />
            </div>
            <div class="form-group">
              <label>Teléfono</label>
              <input type="tel" placeholder="+593 ..." />
            </div>
          </div>

          <div class="form-group">
            <label>Correo electrónico</label>
            <input type="email" placeholder="tu@correo.com" required />
          </div>

          <div class="form-group">
            <label>Servicio de interés</label>
            <select>
              <option value="">Selecciona un servicio...</option>
              <option value="landing">Landing Page</option>
              <option value="corporativa">Web Corporativa</option>
              <option value="plataforma">Plataforma Web</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div class="form-group">
            <label>Cuéntanos sobre tu proyecto</label>
            <textarea rows="4" placeholder="Describe tu idea o proyecto..."></textarea>
          </div>

          <button type="submit" class="btn btn-gradient btn-full">
            Enviar mensaje <span class="arrow">→</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 100px 0;
    background: #020617;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  /* Info Cards Styles */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    padding: 1rem 1.2rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .whatsapp-card {
    background: #22c55e;
    color: white;
    border: none;
    box-shadow: 0 10px 20px rgba(34, 197, 94, 0.2);
  }

  .whatsapp-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(34, 197, 94, 0.3);
  }

  .icon-bg {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.6rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-small {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.8rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .info-content h4 {
    color: white;
    font-size: 1rem;
    margin-bottom: 0.1rem;
  }

  .whatsapp-card .info-content h4 { color: white; }

  .info-content p {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0;
  }

  .whatsapp-card .info-content p { color: rgba(255, 255, 255, 0.9); }

  .whatsapp-card .arrow {
    margin-left: auto;
    font-size: 1.5rem;
    opacity: 0.8;
  }

  .coming-soon {
    flex-direction: column;
    align-items: flex-start;
    padding: 1.2rem 1.5rem;
  }

  .coming-soon h5 {
    color: #a855f7;
    letter-spacing: 2px;
    font-size: 0.7rem;
    margin-bottom: 0.8rem;
  }

  .future-emails p {
    margin-bottom: 0.4rem;
    color: #6366f1;
    font-weight: 600;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
  }

  /* Form Styles */
  .contact-form-container {
    background: rgba(15, 23, 42, 0.5);
    padding: 3rem;
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .contact-form-container h3 {
    font-size: 2rem;
    color: white;
    margin-bottom: 2.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    color: white;
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
    font-weight: 500;
  }

  input, select, textarea {
    width: 100%;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem 1.2rem;
    border-radius: 12px;
    color: white;
    font-family: inherit;
    transition: all 0.3s ease;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: #6366f1;
    background: rgba(30, 41, 59, 0.8);
  }

  .btn-full {
    width: 100%;
    justify-content: center;
    margin-top: 1rem;
  }

  @media (max-width: 968px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .contact-form-container {
      padding: 2rem 1.5rem;
    }
  }
</style>
