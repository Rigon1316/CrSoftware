---
const projects = [
  {
    title: "Gestcore",
    description: "Plataforma SaaS avanzada para la gestión integral de cartera y cobranza bancaria.",
    tags: ["SaaS", "FinTech", "Dashboard"],
    tech: ["HTML5", "CSS3", "JavaScript"],
    image: "/projects/gestcore.png",
    link: "https://www.gestcore.com",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="project-placeholder-icon"><path d="M2 3h20v14H2z"></path><path d="M8 21h8"></path><path d="M12 17v4"></path></svg>`,
    customClass: "zoom-img"
  }
];
---

<section class="projects">
  <div class="container">
    <div class="section-header reveal">
      <span class="gradient-text">Proyectos Realizados</span>
      <h2>Nuestros casos de éxito</h2>
    </div>

    <div class="projects-grid">
      {projects.map((project, index) => (
        <a href={project.link || "#"} target={project.link ? "_blank" : "_self"} class="project-card reveal" style={`animation-delay: ${index * 0.1}s`}>
          <div class="project-preview">
            {project.image ? (
              <img src={project.image} alt={project.title} class={`project-img ${project.customClass || ''}`} />
            ) : (
              <div class="icon-wrapper" set:html={project.icon} />
            )}
          </div>
          
          <div class="project-info">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            
            {!project.image && (
              <div class="cta-inline">
                <span class="cta-text">Construye el tuyo</span>
                <span class="cta-button">aquí</span>
              </div>
            )}

            <div class="tags-group">
              <span class="tags-label">Categoría:</span>
              <div class="tags">
                {project.tags?.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>

            <div class="tags-group">
              <span class="tags-label">Tecnologías:</span>
              <div class="tags">
                {project.tech?.map(t => (
                  <span class="tag tech">{t}</span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 4rem 0 8rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header span {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.9rem;
  }

  .section-header h2 {
    font-size: 3rem;
    margin-top: 1rem;
  }

  .projects-grid {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .project-card {
    max-width: 480px;
    width: 100%;
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid var(--glass-border);
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    transform: translateY(-12px);
    border-color: var(--primary);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .project-preview {
    height: 240px;
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.05), rgba(14, 165, 233, 0.05));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border-bottom: 1px solid var(--glass-border);
    overflow: hidden;
    position: relative;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .project-img.zoom-img {
    transform: scale(1.15);
    object-position: center 20%;
  }

  .project-card:hover .project-img.zoom-img {
    transform: scale(1.25);
  }

  .cta-inline {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 0.5rem 0;
  }

  .cta-inline .cta-text {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cta-inline .cta-button {
    background: var(--primary);
    color: white;
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: 0 4px 15px var(--primary-glow);
    transition: all 0.3s ease;
  }

  .project-card:hover .cta-inline .cta-button {
    background: var(--primary-light);
    transform: scale(1.05);
  }

  .creative-tech-block {
    border-left: 3px solid var(--primary);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
  }

  .creative-tech-text {
    color: var(--text-main);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.5;
    opacity: 0.9;
  }

  .icon-wrapper {
    color: var(--primary);
    filter: drop-shadow(0 0 10px var(--primary-glow));
    transition: transform 0.3s ease;
  }

  .project-card:hover .icon-wrapper {
    transform: scale(1.1) translateY(-5px);
  }

  .icon-wrapper :global(svg) {
    width: 3.5rem;
    height: 3.5rem;
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .project-card:hover .cta-content {
    opacity: 1;
    transform: translateY(-5px);
  }

  .cta-text {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cta-button {
    background: var(--primary);
    color: white;
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 4px 15px var(--primary-glow);
    transition: all 0.3s ease;
  }

  .project-card:hover .cta-button {
    background: var(--primary-light);
    box-shadow: 0 6px 20px var(--primary-glow);
    transform: scale(1.05);
  }

  .project-info {
    padding: 2.5rem 2rem;
  }

  .project-info h3 {
    font-size: 1.5rem;
    color: var(--text-main);
    margin-bottom: 0.8rem;
  }

  .project-info p {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .tags-group {
    margin-bottom: 1.2rem;
  }

  .tags-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag {
    background: rgba(99, 102, 241, 0.1);
    color: #818cf8;
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .tag.tech {
    background: rgba(168, 85, 247, 0.1);
    color: #c084fc;
    border-color: rgba(168, 85, 247, 0.2);
  }

  @media (max-width: 768px) {
    .section-header h2 {
      font-size: 2.2rem;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
