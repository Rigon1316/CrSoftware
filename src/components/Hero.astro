---
---
<section class="hero">
  <div class="grid-background"></div>
  <div class="code-overlay">
    <div class="code-column c1"><span>&lt;html&gt;</span><span>const dev = true;</span><span>build()</span></div>
    <div class="code-column c2"><span>API.connect()</span><span>optimize()</span><span>&lt;/body&gt;</span></div>
    <div class="code-column c3"><span>deploy()</span><span>render()</span><span>010101</span></div>
  </div>
  <div class="container hero-wrapper">
    <div class="hero-content reveal">
      <div class="badge-new">
        <span class="star">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
        </span> 
        INNOVACIÓN DIGITAL
      </div>
      <h1>Transformamos <br/> tus ideas en <br/> <span class="gradient-text-hero">Software Real</span></h1>
      <p>
        Desarrollamos soluciones personalizadas que impulsan el crecimiento de tu negocio. Desde aplicaciones web hasta sistemas empresariales complejos.
      </p>
      <p class="secondary-phrase">
        No solo escribimos código, construimos el <span class="highlight">motor digital</span> de tu éxito.
      </p>
      <div class="hero-actions">
        <a href="#contacto" class="btn btn-gradient">Empieza Hoy <span class="arrow">→</span></a>
        <a href="#servicios" class="btn btn-outline-dark">Ver Servicios</a>
      </div>

      <div class="hero-stats reveal">
        <div class="stat-item">
          <span class="stat-value">100%</span>
          <span class="stat-label">Satisfacción <br/> Garantizada</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">24/7</span>
          <span class="stat-label">Soporte <br/> Técnico</span>
        </div>
      </div>
    </div>

    <div class="hero-visual reveal">
      <div class="orbit-container">
        <div class="floating-badge web">
          <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </span> 
          Web Profesional
        </div>
        <div class="floating-badge secure">
          <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </span> 
          100% Seguro
        </div>
      </div>

      <div class="feature-card glass">
        <div class="feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #f59e0b;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        </div>
        <h3>Desarrollo Rápido</h3>
        <p>Entregamos en tiempo récord</p>
        <div class="progress-bar">
          <div class="progress-fill"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    padding: 80px 0 60px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #020617;
  }

  .grid-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: radial-gradient(ellipse at center, black, transparent 80%);
    z-index: 0;
  }

  .hero-wrapper {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .badge-new {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: rgba(147, 51, 234, 0.1);
    border: 1px solid rgba(147, 51, 234, 0.3);
    color: #a855f7;
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 2rem;
  }

  .star {
    display: flex;
    align-items: center;
  }

  h1 {
    font-size: 5.5rem;
    line-height: 1.05;
    margin-bottom: 2rem;
    font-weight: 800;
    color: white;
  }

  .gradient-text-hero {
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  p {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 540px;
    margin-bottom: 3rem;
    line-height: 1.6;
  }

  .secondary-phrase {
    font-size: 1rem;
    color: #94a3b8;
    margin-top: -1.5rem;
    margin-bottom: 3.5rem;
    font-style: italic;
    opacity: 0.9;
    border-left: 2px solid var(--primary);
    padding-left: 1rem;
  }

  .secondary-phrase .highlight {
    color: var(--primary);
    font-weight: 700;
  }

  .code-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.15;
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: var(--primary);
  }

  .code-column {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    animation: slide-code 20s linear infinite;
  }

  .c1 { left: 5%; top: -10%; animation-duration: 25s; }
  .c2 { left: 45%; top: -20%; animation-duration: 35s; opacity: 0.5; }
  .c3 { right: 10%; top: -5%; animation-duration: 28s; }

  @keyframes slide-code {
    from { transform: translateY(0); }
    to { transform: translateY(100vh); }
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
  }

  .btn-gradient {
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
    transition: all 0.3s ease;
  }

  .btn-gradient:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(99, 102, 241, 0.4);
  }

  .btn-outline-dark {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-outline-dark:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 3rem;
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    color: white;
    line-height: 1;
    background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.1), transparent);
  }

  /* Visual Elements */
  .hero-visual {
    position: relative;
    height: 500px;
  }

  .orbit-container {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 360px;
    height: 360px;
    transform: translate(-50%, -50%);
    animation: rotate-orbit 20s linear infinite;
    z-index: 2;
    pointer-events: none;
  }

  .floating-badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(30, 41, 59, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.6rem 1.4rem;
    border-radius: 50px;
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    white-space: nowrap;
    pointer-events: auto;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    animation: counter-rotate 20s linear infinite;
  }

  .floating-badge.secure {
    top: auto;
    bottom: 0;
    border-color: rgba(16, 185, 129, 0.3);
    color: #10b981;
  }

  .feature-card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 260px;
    padding: 1.8rem;
    background: rgba(15, 23, 42, 0.95);
    border: 1.5px solid rgba(147, 51, 234, 0.3);
    box-shadow: 0 0 40px rgba(147, 51, 234, 0.15);
    border-radius: 28px;
    text-align: left;
    z-index: 1;
  }

  .feature-icon {
    margin-bottom: 1.2rem;
  }

  .feature-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.4rem;
    color: var(--text-main);
  }

  .feature-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }

  .progress-bar {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
  }

  .progress-fill {
    width: 75%;
    height: 100%;
    background: linear-gradient(90deg, #6366f1, #06b6d4);
    border-radius: 10px;
    animation: progress 2s ease-out forwards;
  }

  @keyframes rotate-orbit {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes counter-rotate {
    from { transform: translateX(-50%) rotate(0deg); }
    to { transform: translateX(-50%) rotate(-360deg); }
  }

  @keyframes progress {
    from { width: 0; }
    to { width: 75%; }
  }

  @media (max-width: 1200px) {
    h1 { font-size: 4rem; }
    .orbit-container { width: 380px; height: 380px; }
  }

  @media (max-width: 968px) {
    .hero-wrapper {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 5rem;
    }
    h1 { font-size: 3.5rem; }
    p { margin: 0 auto 3rem; }
    .hero-actions { justify-content: center; }
    .hero-stats { justify-content: center; gap: 1.5rem; margin-top: 4rem; flex-wrap: wrap; }
    .stat-divider { display: none; }
    .stat-item { flex: 1 1 120px; }
    .hero-visual { display: none; }
    .orbit-container { width: 340px; height: 340px; }
  }
</style>
