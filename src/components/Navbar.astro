---
---
<nav class="navbar glass">
  <div class="container nav-header">
    <div class="logo">
      <img src="/logo.png" alt="CR Software Corporation Logo" class="nav-logo" />
    </div>
    
    <div class="mobile-toggle" id="mobile-toggle">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>

  <div class="nav-links-wrapper">
    <ul class="nav-links">
      <li><a href="#inicio">Inicio</a></li>
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#conoce-mas">Conoce más</a></li>
      <li><a href="#contacto" class="btn btn-primary">Contáctanos</a></li>
    </ul>
  </div>
</nav>

<script>
  const mobileToggle = document.getElementById('mobile-toggle');
  const navbar = document.querySelector('.navbar');
  const navLinks = document.querySelectorAll('.nav-links a');

  mobileToggle?.addEventListener('click', () => {
    mobileToggle.classList.toggle('active');
    navbar?.classList.toggle('mobile-active');
  });

  // Close menu when clicking a link
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileToggle?.classList.remove('active');
      navbar?.classList.remove('mobile-active');
    });
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1100px;
    height: 70px;
    z-index: 1000;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 100px;
    background: var(--bg-card);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .nav-header {
    width: 100%;
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .nav-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .logo:hover {
    transform: scale(1.05);
  }

  .nav-links-wrapper {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-main);
    opacity: 0.8;
    font-weight: 500;
    transition: all 0.3;
    font-size: 0.95rem;
  }

  .nav-links a:hover,
  .nav-links a.active-link {
    color: var(--primary);
    opacity: 1;
    transform: translateY(-1px);
  }

  .nav-links a.btn-primary {
    background: linear-gradient(135deg, #0ea5e9, #9333ea);
    color: white;
    border: none;
    padding: 0.8rem 1.8rem;
    border-radius: 50px;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
  }

  .nav-links a.btn-primary:hover {
    background: linear-gradient(135deg, #0284c7, #7e22ce);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(147, 51, 234, 0.4);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    z-index: 1001;
    padding: 5px;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;
    background: white;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hamburger Animation */
  .mobile-toggle.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-toggle.active span:nth-child(2) {
    opacity: 0;
    transform: translateX(-10px);
  }
  .mobile-toggle.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .navbar {
      width: 94%;
      padding: 0 1.2rem;
      border-radius: 25px;
      flex-direction: column;
      align-items: stretch;
      height: 64px;
      top: 15px;
      justify-content: flex-start;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-header {
      height: 64px;
      width: 100%;
    }

    .navbar.mobile-active {
      height: auto;
      padding-bottom: 2.5rem;
      border-radius: 30px;
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.98) 0%, rgba(30, 41, 59, 0.98) 100%);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }

    .nav-links-wrapper {
      width: 100%;
      height: 0;
      overflow: hidden;
      transition: height 0.4s ease;
    }

    .navbar.mobile-active .nav-links-wrapper {
      height: auto;
      border-top: 1px solid var(--glass-border);
      padding-top: 1rem;
    }

    .nav-links {
      flex-direction: column;
      width: 100%;
      gap: 0.5rem;
      opacity: 0;
      transform: translateY(-10px);
      transition: all 0.3s ease;
    }

    .navbar.mobile-active .nav-links {
      opacity: 1;
      transform: translateY(0);
    }

    .mobile-toggle {
      display: flex;
    }

    .nav-logo {
      height: 32px;
    }

    .nav-links li {
      width: 100%;
      text-align: center;
    }

    .nav-links a {
      font-size: 1.1rem;
      display: block;
      padding: 0.8rem;
      color: white;
      font-weight: 600;
    }

    .nav-links a.btn-primary {
      margin: 1rem 1.5rem 0;
      padding: 1rem;
    }
  }

  /* Extreme mobile (very small screens) */
  @media (max-width: 380px) {
    .nav-logo {
      height: 28px;
    }
    .navbar {
      width: 95%;
    }
    .nav-links a {
      font-size: 1rem;
    }
  }
</style>
