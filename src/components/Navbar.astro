---
---
<nav class="navbar glass">
  <div class="container nav-content">
    <div class="logo">
      <img src="/logo.png" alt="CR Software Corporation Logo" class="nav-logo" />
    </div>
    <ul class="nav-links">
      <li><a href="#inicio">Inicio</a></li>
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#conoce-mas">Conoce más</a></li>
      <li><a href="#contacto" class="btn btn-primary">Contáctanos</a></li>
    </ul>

    <div class="mobile-toggle" id="mobile-toggle">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<script>
  const mobileToggle = document.getElementById('mobile-toggle');
  const navbar = document.querySelector('.navbar');
  const navLinks = document.querySelectorAll('.nav-links a');

  mobileToggle?.addEventListener('click', () => {
    mobileToggle.classList.toggle('active');
    navbar?.classList.toggle('mobile-active');
  });

  // Close menu when clicking a link
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileToggle?.classList.remove('active');
      navbar?.classList.remove('mobile-active');
    });
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1100px;
    height: var(--nav-height);
    z-index: 1000;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    border-radius: 100px;
    background: var(--bg-card);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-content {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .nav-logo {
    height: 45px;
    width: auto;
    object-fit: contain;
  }

  .logo:hover {
    transform: scale(1.05);
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-main);
    opacity: 0.8;
    font-weight: 500;
    transition: all 0.3;
    font-size: 0.95rem;
  }

  .nav-links a:hover,
  .nav-links a.active-link {
    color: var(--primary);
    opacity: 1;
    transform: translateY(-1px);
  }

  .nav-links a.btn-primary {
    background: linear-gradient(135deg, #0ea5e9, #9333ea);
    color: white;
    border: none;
    padding: 0.8rem 1.8rem;
    border-radius: 50px;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
  }

  .nav-links a.btn-primary:hover {
    background: linear-gradient(135deg, #0284c7, #7e22ce);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(147, 51, 234, 0.4);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    z-index: 1001;
    padding: 5px;
    transition: transform 0.3s ease;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;
    background: white;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hamburger Animation */
  .mobile-toggle.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-toggle.active span:nth-child(2) {
    opacity: 0;
    transform: translateX(-10px);
  }
  .mobile-toggle.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .navbar {
      width: 92%;
      padding: 0 1.5rem;
      border-radius: 24px;
      height: 70px; /* Fixed height for header */
      top: 15px;
    }

    .navbar.mobile-active {
      border-radius: 24px;
      background: rgba(15, 23, 42, 0.98);
      border-color: var(--primary);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }

    .nav-links {
      display: none;
      flex-direction: column;
      width: 100%;
      position: absolute;
      top: 70px; /* Below the fixed header height */
      left: 0;
      padding: 2rem 1.5rem;
      background: linear-gradient(to bottom, rgba(15, 23, 42, 1), rgba(30, 41, 59, 1));
      border-radius: 0 0 24px 24px;
      gap: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      z-index: -1;
    }

    .navbar.mobile-active .nav-links {
      display: flex;
      animation: slideDown 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    @keyframes slideDown {
      from { transform: translateY(-10px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    .mobile-toggle {
      display: flex;
    }



    .nav-logo {
      height: 32px;
    }

    .nav-links li {
      width: 100%;
      text-align: center;
    }

    .nav-links a {
      font-size: 1.1rem;
      display: block;
      padding: 0.5rem;
      color: white;
      opacity: 0.9;
    }

    .nav-links a.active-link {
      color: var(--primary);
      font-weight: 700;
    }

    .nav-links a.btn-primary {
      margin: 0.5rem 0;
      padding: 1rem;
    }
  }
</style>
