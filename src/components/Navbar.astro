---
<nav class="navbar glass">
  <div class="container nav-content">
    <div class="logo">
      <img src="/logo.png" alt="CR Software Corporation Logo" class="nav-logo" />
    </div>
    <ul class="nav-links">
      <li><a href="#inicio">Inicio</a></li>
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#conoce-mas">Conoce más</a></li>
      <li><a href="#contacto" class="btn btn-primary">Contáctanos</a></li>
    </ul>

    <div class="mobile-toggle">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1100px;
    height: var(--nav-height);
    z-index: 1000;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    border-radius: 100px;
    background: var(--bg-card); /* Adaptable Glass */
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .nav-content {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .nav-logo {
    height: 45px;
    width: auto;
    object-fit: contain;
  }

  .logo:hover {
    transform: scale(1.05);
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-main);
    opacity: 0.8;
    font-weight: 500;
    transition: all 0.3s;
    font-size: 0.95rem;
  }

  .nav-links a:hover,
  .nav-links a.active-link {
    color: var(--primary);
    opacity: 1;
    transform: translateY(-1px);
  }

  .nav-links a.btn-primary {
    background: linear-gradient(135deg, #0ea5e9, #9333ea);
    color: white;
    border: none;
    padding: 0.8rem 1.8rem;
    border-radius: 50px;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
  }

  .nav-links a.btn-primary:hover {
    background: linear-gradient(135deg, #0284c7, #7e22ce);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(147, 51, 234, 0.4);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;
    background: var(--text-main);
    border-radius: 2px;
  }

  @media (max-width: 1024px) {
    .nav-links {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .navbar {
      width: 95%;
      padding: 0 1.2rem;
    }
    .nav-logo {
      height: 35px;
    }
  }
</style>
