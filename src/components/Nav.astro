---
const { active = '' } = Astro.props;

function isActive(page: string): string {
  return active === page ? 'active' : '';
}
---

<nav id="navbar">
  <div class="nav-logo">
    <img src="/images/logo.png" alt="CRSoftware Logo" />
  </div>

  <ul class="nav-links">
    <li>
      <a href="/index.html" class={isActive('inicio')}>
        Inicio
      </a>
    </li>

    <li>
      <a href="/quienes-somos.html" class={isActive('quienes')}>
        Quiénes Somos
      </a>
    </li>

    <li>
      <a href="/servicios.html" class={isActive('servicios')}>
        Servicios
      </a>
    </li>
  </ul>

  <div class="nav-cta-wrap">
    <a href="/contacto.html" class="btn btn-primary nav-cta">
      Contáctanos
    </a>
  </div>

  <button class="hamburger" aria-label="Menú">
    <span></span><span></span><span></span>
  </button>
</nav>